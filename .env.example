# Mode GitHub Pages (default). Jangan simpan secret di VITE_*.
VITE_CMS_MODE=github
VITE_GITHUB_REPO=farhanreninda/farhanreninda.github.io
VITE_GITHUB_BRANCH=main
# URL HTTPS Worker OAuth setelah dikonfigurasi.
VITE_GITHUB_AUTH_URL=

# Mode Node/SQLite lokal opsional: VITE_CMS_MODE=local.
CMS_ACCESS_WORD=
CMS_DB_PATH=./data/cms.sqlite
PORT=3001
HOST=127.0.0.1
